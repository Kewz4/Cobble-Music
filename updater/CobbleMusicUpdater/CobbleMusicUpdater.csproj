<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CobbleMusicUpdater</AssemblyName>
    <RootNamespace>CobbleMusicUpdater</RootNamespace>
    <Version>1.2.22</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 1.2.18: measured 121,450,566 -> 54,371,276 bytes (-55%); first window +~80 ms; the pinned bootstrap's
         per-launch SHA-256 passes over this exe take ~half as long; build stays byte-reproducible
         (tests/Test-UpdaterBuildReproducibility.ps1). Trimming/AOT are unavailable for WinForms. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <!-- 1.2.22 lite mode, round 2: the processor and graphics card score tables (lite0924/hwdb, normaliser hwdb-norm-1). -->
  <ItemGroup>
    <EmbeddedResource Include="HardwareDb\cpu_scores.json" LogicalName="HardwareDb.cpu_scores.json" />
    <EmbeddedResource Include="HardwareDb\gpu_scores.json" LogicalName="HardwareDb.gpu_scores.json" />
  </ItemGroup>
</Project>
