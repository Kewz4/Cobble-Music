<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CobbleMusicUpdater.Tests</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CobbleMusicUpdater\CobbleMusicUpdater.csproj" />
  </ItemGroup>
  <!-- 1.2.18 jvm track: byte-exact Prism cfg fixtures for JvmSettingsTests.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\Jvm\*.cfg" LogicalName="JvmFixtures.%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- 1.2.22 lite round 2: the hwdb test vectors (lite0924/hwdb/tests) and the Python reference's result for each. -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\Hwdb\*.tsv" LogicalName="HwdbFixtures.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
